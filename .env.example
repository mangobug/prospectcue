# Public Supabase URL and publishable/anon key (RLS protects access).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Server-only canonical origin; register auth redirects in Supabase.
APP_URL=http://localhost:3000
# No service-role key is used by the application.
