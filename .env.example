# Public Supabase URL and publishable/anon key (RLS protects access).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Server-only canonical origin; register auth redirects in Supabase.
APP_URL=http://localhost:3000
# No service-role key is used by the application.
# Optional server-only Google Places API (New) key. Overture works without it.
GOOGLE_PLACES_API_KEY=
# Background audits. The same random secret (32+ characters) belongs in Vercel
# and Trigger.dev. Never use a Supabase service-role key in either application.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=
AUDIT_JOB_SECRET=
# Optional, server-only on the audit worker. Enable PageSpeed Insights API.
GOOGLE_PAGESPEED_API_KEY=
# Local development only; never enable on hosted deployments.
AUDIT_LOCAL_WORKER=0
